---
import Layout from "../layouts/Layout.astro"
---

<Layout title="Contact | Gerardo Tamayo">
    <main 
        style="background-image: url('/fondo2.webp'); background-size: cover; background-attachment: fixed;" 
        class="bg-center min-h-screen flex items-center justify-center px-4 py-24"
    >
        <div class="w-full max-w-lg rounded-2xl bg-stone-300/90 p-8 shadow-md backdrop-blur-sm">
            <form action="" method="POST" class="flex flex-col gap-4">
                <label for="name">Nombre:</label>
                <input id="name" type="text" name="name" class="p-2 rounded-md" required/>

                <label for="email">Email:</label>
                <input id="email" type="email" name="email" class="p-2 rounded-md" required/>

                <label for="message">Mensaje:</label>
                <textarea id="message" name="message" rows="4" class="p-2 rounded-md" required></textarea>
                
                <button type="submit" class="bg-gray-700 p-3 rounded-2xl text-white mt-4">Enviar</button>
            </form>
        </div>
    </main>
</Layout>